# Copia este archivo a .env (ignorado por git). En builds de EAS se definen con `eas env:create`.
# La publishable key está pensada para ir en el cliente; la seguridad la dan las políticas RLS.
EXPO_PUBLIC_SUPABASE_URL=https://zoidnphuqxuvocoelrfj.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_a8U0UY8TqbgHtQsSo1Cqvw_jIyyphzc
# Clave de Google Places (restringela por bundle ID/package en Google Cloud). En EAS: `eas env:create`.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
# OAuth de Google (Google Cloud Console). Configurar los mismos client IDs en Supabase > Authentication > Providers > Google.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
